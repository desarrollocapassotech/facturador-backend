# Neon: DATABASE_URL con pooler (runtime), DIRECT_URL sin pooler (migraciones)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/facturador?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/facturador?sslmode=require"

# Sesión: al menos 32 caracteres aleatorios (node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# Cifrado de certificados ARCA (AES-256-GCM). Al menos 32 caracteres. Tiene que ser la misma en
# todos los entornos que compartan base: si cambia, los certificados guardados no se pueden leer.
FACTURADOR_ENCRYPTION_KEY=""

# Token de AfipSDK (app.afipsdk.com). Sin esto el backend arranca pero no puede emitir.
AFIP_SDK_API_KEY=""

# Origen del frontend permitido por CORS (separar varios con coma)
FRONTEND_URL="http://localhost:5173"
PORT=3000
