            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComprobantePublicoDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Emitir un comprobante en ARCA",
        "tags": [
          "API pública"
        ]
      }
    },
