  "components": {
    "securitySchemes": {
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "API key de la integración (fct_…)."
      }
    },
    "schemas": {
      "EmitirTokenAccesoDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 200,
            "format": "email"
          },
          "nombre": {
            "type": "string",
            "maxLength": 120
          },
          "destino": {
            "type": "string",
            "description": "Path del frontend al que llevar después de entrar (lista blanca; si no es válido, se ignora).",
            "maxLength": 200
          }
        },
        "required": [
          "email"
        ]
      },
      "CrearClienteDto": {
        "type": "object",
        "properties": {
          "razonSocial": {
            "type": "string",
            "maxLength": 200
          },
          "tipoDocumento": {
            "enum": [
              "CONSUMIDOR_FINAL",
              "CUIT",
              "CUIL",
              "DNI",
              "PASAPORTE"
            ],
            "type": "string"
          },
          "numeroDocumento": {
            "type": "string",
            "maxLength": 20
          },
          "condicionIva": {
            "enum": [
              "RESPONSABLE_INSCRIPTO",
              "EXENTO",
              "CONSUMIDOR_FINAL",
              "MONOTRIBUTO",
              "NO_CATEGORIZADO",
              "PROVEEDOR_EXTERIOR",
              "CLIENTE_EXTERIOR",
              "IVA_LIBERADO",
              "MONOTRIBUTO_SOCIAL",
              "NO_ALCANZADO",
              "MONOTRIBUTO_TIP"
            ],
            "type": "string"
          },
          "domicilio": {
            "type": "string",
            "maxLength": 300
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "pais": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "monedaPreferida": {
            "enum": [
              "ARS",
              "USD"
            ],
            "type": "string"
          },
          "diasVencimiento": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 365
          }
        },
        "required": [
          "razonSocial",
          "tipoDocumento",
          "numeroDocumento",
          "condicionIva"
        ]
      },
      "AltaClienteDto": {
        "type": "object",
        "properties": {
          "razonSocial": {
            "type": "string",
            "description": "Razón social para dar de alta al cliente si no existe (se ofrece en el staging).",
            "maxLength": 200
          },
          "condicionIva": {
            "type": "string",
            "description": "RESPONSABLE_INSCRIPTO, MONOTRIBUTO, EXENTO, CONSUMIDOR_FINAL, …",
            "maxLength": 40
          },
          "domicilio": {
            "type": "string",
            "maxLength": 300
          },
          "email": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "razonSocial"
        ]
      },
      "ClienteRefDto": {
        "type": "object",
        "properties": {
          "clienteId": {
            "type": "string",
            "description": "Id del cliente en el Facturador.",
            "maxLength": 50
          },
          "tipoDocumento": {
            "type": "string",
            "description": "Tipo de documento, si se identifica por documento.",
            "enum": [
              "CUIT",
              "CUIL",
              "DNI",
              "PASAPORTE",
              "CONSUMIDOR_FINAL"
            ]
          },
          "numeroDocumento": {
            "type": "string",
            "description": "Número de documento (con o sin guiones).",
            "maxLength": 20
          },
          "referenciaExterna": {
            "type": "string",
            "description": "Id del cliente en tu sistema. Se asocia al cliente del Facturador la primera vez que se resuelve.",
            "maxLength": 200
          },
          "alta": {
            "$ref": "#/components/schemas/AltaClienteDto"
          }
        }
      },
      "PeriodoDto": {
        "type": "object",
        "properties": {
          "desde": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "hasta": {
            "type": "string",
            "description": "YYYY-MM-DD"
          }
        },
        "required": [
          "desde",
          "hasta"
        ]
      },
      "ItemApiDto": {
        "type": "object",
        "properties": {
          "referenciaExterna": {
            "type": "string",
            "description": "Id estable en tu sistema. Reenviar la misma referencia con los mismos datos no duplica; con datos distintos, actualiza.",
            "maxLength": 200
          },
          "cliente": {
            "$ref": "#/components/schemas/ClienteRefDto"
          },
          "descripcion": {
            "type": "string",
            "maxLength": 500
          },
          "cantidad": {
            "type": "string",
            "description": "Decimal como string, con punto: \"10.5\".",
            "maxLength": 30
          },
          "unidad": {
            "type": "string",
            "enum": [
              "HORA",
              "UNIDAD",
              "SERVICIO",
              "MES"
            ]
          },
          "precioUnitario": {
            "type": "string",
            "description": "Sin IVA, decimal como string. Si falta, se toma de la tarifa vigente del cliente.",
            "maxLength": 30
          },
          "moneda": {
            "type": "string",
            "enum": [
              "ARS",
              "USD"
            ]
          },
          "alicuotaIva": {
            "type": "string",
            "description": "\"0\", \"2.5\", \"5\", \"10.5\", \"21\" o \"27\".",
            "maxLength": 5
          },
          "fecha": {
            "type": "string",
            "description": "YYYY-MM-DD",
            "maxLength": 10
          },
          "periodo": {
            "description": "Período del servicio (ARCA lo exige para servicios; si no hay, se usa `fecha`).",
            "allOf": [
              {
                "$ref": "#/components/schemas/PeriodoDto"
              }
            ]
          },
          "metadatos": {
            "type": "object",
            "additionalProperties": true,
            "description": "Datos libres que querés conservar con el ítem (se devuelven tal cual)."
          }
        },
        "required": [
          "referenciaExterna",
          "cliente",
          "descripcion",
          "cantidad",
          "unidad"
        ]
      },
      "CargarItemsDto": {
        "type": "object",
        "properties": {
          "items": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemApiDto"
            }
          },
          "descripcion": {
            "type": "string",
            "description": "Texto para reconocer el lote en el Facturador.",
            "maxLength": 200
          },
          "confirmar": {
            "type": "boolean",
            "description": "Confirmar el lote en el mismo request (deja los ítems válidos listos para facturar)."
          }
        },
        "required": [
          "items"
        ]
      },
      "AdvertenciaDto": {
        "type": "object",
        "properties": {
          "referencia": {
